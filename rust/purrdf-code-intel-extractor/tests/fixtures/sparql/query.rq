PREFIX ex: <https://example.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?s ?o WHERE {
  GRAPH ex:g {
    ?s ex:p/ex:q+ ?o .
    ?reifier rdf:reifies <<( ?s ex:p ?o )>> .
  }
  SERVICE SILENT <https://example.org/sparql> {
    ?s ex:remote ?o .
  }
}
