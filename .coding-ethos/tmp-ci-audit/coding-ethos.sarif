{
	"$schema": "https://json.schemastore.org/sarif-2.1.0.json",
	"version": "2.1.0",
	"runs": [
		{
			"tool": {
				"driver": {
					"name": "coding-ethos",
					"informationUri": "https://github.com/paudley/coding-ethos"
				}
			},
			"invocations": [
				{
					"workingDirectory": {
						"uri": "."
					},
					"executionSuccessful": true
				}
			],
			"automationDetails": {
				"id": ".github/workflows/ci.yml:policy/"
			},
			"results": [],
			"properties": {
				"scope": "files",
				"policy_coverage": {
					"policies": [
						"agent_workspace.enforcement_point_write",
						"filesystem.large_files",
						"filesystem.line_limits",
						"filesystem.shebangs",
						"git.edit_evasive_git_execution",
						"python.catch_and_silence",
						"python.conditional_imports",
						"python.direct_imports",
						"python.optional_returns",
						"python.pyproject_ignores",
						"python.structured_logging",
						"repo.license_header",
						"repo.pii_scrubber",
						"runtime.managed_tool_capability_contract",
						"runtime.network_requires_approval",
						"security.private_key",
						"shell.best_practices",
						"shell.forbidden_strings",
						"shell.malformed_command",
						"syntax.file_syntax",
						"syntax.merge_conflict"
					],
					"ethos_ids": [
						"documentation-as-contract",
						"exception-hierarchy-and-error-messages",
						"fail-fast-fail-hard-overview",
						"forward-motion-only",
						"linting-as-code-quality-enforcement",
						"no-conditional-imports",
						"no-inline-cli-environment-variables",
						"no-optional-types-for-required-dependencies",
						"one-path-for-critical-operations",
						"protocol-first-design",
						"radical-visibility",
						"security-by-design",
						"solid-is-law",
						"static-analysis-is-the-first-line-of-defense",
						"validation-at-the-gate"
					],
					"policy_count": 21,
					"ethos_count": 15,
					"decision_count": 21
				}
			}
		}
	]
}
